{
  "name": "opnsense-mcp",
  "version": "0.2.0",
  "description": "Safety-focused MCP server for the OPNsense API",
  "type": "module",
  "bin": {
    "opnsense-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example",
    "config.example.json"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "dev:http": "MCP_TRANSPORT=http tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "undici": "^7.15.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
