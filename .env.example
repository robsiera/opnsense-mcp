# Single-instance mode (default):
OPNSENSE_URL=https://opnsense.example.com
OPNSENSE_API_KEY=replace-me
OPNSENSE_API_SECRET=replace-me
# OPNSENSE_INSTANCE_NAME=default

# Multi-instance mode: point at a JSON file (see config.example.json) instead of OPNSENSE_URL/KEY/SECRET.
# OPNSENSE_CONFIG_PATH=/absolute/path/to/opnsense-instances.json
# OPNSENSE_DEFAULT_INSTANCE=bxl

# disabled: read-only tools only; plan: describe writes but never execute; enabled: execute with a plan token
# Used for the single-env instance, and as the default write_mode for file instances that omit write_mode.
OPNSENSE_WRITE_MODE=disabled

# Prefer a trusted certificate or private CA. Never disable verification in production.
# OPNSENSE_CA_FILE=/absolute/path/to/opnsense-ca.pem
# OPNSENSE_TLS_VERIFY=true
# OPNSENSE_ALLOW_HTTP=false
# OPNSENSE_TIMEOUT_MS=30000
# OPNSENSE_MAX_RESPONSE_BYTES=2097152

# Remote Streamable HTTP transport is the default. Generate a long random token,
# for example: openssl rand -hex 32
MCP_TRANSPORT=http
MCP_HOST=127.0.0.1
MCP_PORT=3000
MCP_PATH=/mcp
MCP_AUTH_TOKEN=replace-with-at-least-32-random-characters

# Required when binding to a non-loopback address. Hostnames only, without ports.
# MCP_ALLOWED_HOSTS=mcp.example.com,localhost
# Browser origins are rejected unless explicitly listed. Non-browser agents usually omit Origin.
# MCP_ALLOWED_ORIGINS=https://agents.example.com
# MCP_MAX_SESSIONS=100
# MCP_SESSION_TTL_MS=3600000
# MCP_RATE_LIMIT_PER_MINUTE=120
